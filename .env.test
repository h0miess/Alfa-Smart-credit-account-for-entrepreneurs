APP__ENVIRONMENT=dev
APP__AUTH_ENABLED=true

POSTGRES__HOST=credit-postgres
POSTGRES__PORT=5432
POSTGRES__DB=credit_cabinet
POSTGRES__USER=admin
POSTGRES__PASSWORD=credit_cabinet

SQL_ENGINE__ECHO=false
SQL_ENGINE__ECHO_POOL=false
SQL_ENGINE__POOL_SIZE=5
SQL_ENGINE__MAX_OVERFLOW=10

AUTH__KEYCLOAK__BASE_URL=http://credit-keycloak:8080
AUTH__KEYCLOAK__PUBLIC_URL=http://localhost:8080
AUTH__KEYCLOAK__REALM=alfa-credit
AUTH__KEYCLOAK__CLIENT_ID=credit-cabinet-web

AUTH__JWT__ISSUER=http://localhost:8080/realms/alfa-credit
AUTH__JWT__AUDIENCE=["credit-backend"]
AUTH__JWT__VERIFY_AUTHORIZED_PARTY=true

REDIS__HOST=credit-redis
REDIS__PORT=6379
