meta {
  name: Калькулятор платежа
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/calculator
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "product": "express",
    "amount": 1500000,
    "term_months": 12
  }
}

assert {
  res.status: eq 200
}
