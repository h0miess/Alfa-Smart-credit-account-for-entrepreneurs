meta {
  name: Черновик экспресс-кредита
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/applications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "product": "express",
    "requested_amount": 1500000,
    "term_months": 12,
    "purpose": "working_capital"
  }
}

vars:post-response {
  applicationId: res.body.id
}

assert {
  res.status: eq 201
}
