# Тестовые настройки бэкенда: скопируйте в backend/.env
# docker compose передаёт backend/.env в контейнер через env_file.
# При запуске без Docker переопределите хост: POSTGRES__HOST=localhost

# Подключение к PostgreSQL
POSTGRES__HOST=credit-postgres
POSTGRES__PORT=5432
POSTGRES__DB=credit_cabinet
POSTGRES__USER=admin
POSTGRES__PASSWORD=credit_cabinet

# Движок SQLAlchemy и пул соединений
SQL_ENGINE__ECHO=false
SQL_ENGINE__ECHO_POOL=false
SQL_ENGINE__POOL_SIZE=5
SQL_ENGINE__MAX_OVERFLOW=10
